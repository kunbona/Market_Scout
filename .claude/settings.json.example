{
  "env": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ANTHROPIC_AUTH_TOKEN": "sk-or-v1-YOUR_OPENROUTER_KEY_HERE",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_MODEL": "anthropic/claude-sonnet-4.6",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
  },
  "enabledMcpjsonServers": ["sina-finance", "thx-hotrend"],
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(python src/cli/advance.py)",
      "Bash(python src/cli/execute.py*)",
      "Bash(python src/cli/query.py*)",
      "Bash(python src/cli/knowledge.py*)",
      "Bash(python src/pipeline/*.py*)",
      "Read(data/agent/**)",
      "Read(data/agent/knowledge/**)",
      "Read(data/pipeline/**)",
      "Read(memory/**)",
      "Write(data/agent/reviews/**)",
      "Write(data/agent/knowledge/**)",
      "Write(memory/**)",
      "Bash(touch data/agent/simulation/.day_complete)",
      "Bash(python agent/query.py*)",
      "Bash(python agent/write_result.py*)"
    ]
  }
}
