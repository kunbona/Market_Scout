# Market Radar 环境变量配置模板
# 复制为 .env (或用 launchctl setenv), 不提交到 git

# =============================================================================
# 企业微信机器人推送 (WECOM_DRY_RUN)
# =============================================================================
# 默认真发 (跟原 auto_runner 行为一致 — key 配了就自动推)
# sandbox 模式: 显式设 WECOM_DRY_RUN=1 (开发/测试时)
#
# 启动 server 时:
#   WECOM_DRY_RUN=0 (默认)  → 真发 (生产)
#   WECOM_DRY_RUN=1          → 沙盒, 推送只 print 不真发 (开发/测试)
#
# 启动时 server log 会显眼打印当前 WECOM_DRY_RUN 值, 一眼看到
#
# webhook key 已在 fetcher/stock_top_algorithms/config.py 写死 (user 自己配的)
# 也可在此覆盖: WECOM_ROBOT_KEY=2e9d429d-2e21-40e3-8a84-b098c9b30f8e
# 不同通道用不同 key (info/warn):
#   WECOM_ROBOT_KEY_INFO=...
#   WECOM_ROBOT_KEY_WARN=...
WECOM_DRY_RUN=0

# =============================================================================
# QMT 桥接 (生产用, 沙盒/本地开发可空)
# =============================================================================
# QMT_BRIDGE_TOKEN=18e74dbc200321da6335ad60dc53a3573026e12a528843f86a78013a73d69850
# QMT_BRIDGE_URL=http://10.211.55.4:5001

# =============================================================================
# 周期信号数据路径 (可选, 默认 = market-radar/data/)
# =============================================================================
# CYCLE_SIGNAL_DATA_PATH=/Users/kun/Documents/market-radar

# =============================================================================
# cycle refresh fallback 模式用的 python 解释器 (可选)
# =============================================================================
# CYCLE_REFRESH_PYTHON=/opt/anaconda3/envs/Kun/bin/python

# =============================================================================
# Agent 自动推送 (盘前 6:00 / 盘中 10:00+13:30 / 盘后 21:00 跑完自动推企微)
# =============================================================================
# 开关: 1=开 (默认 0=关, 跟原来 auto_runner 不自动推的保守行为一致)
# AGENT_AUTO_NOTIFY=1
# 目标地址: 写死的 config.WECOM_ROBOT_KEYS 里的某个 key 名, 默认 info
# AGENT_AUTO_NOTIFY_ADDRESS=info
# 是否推完整内容 (DB report_html 剥 HTML, send_ai_report 会按 4096 字节自动分段):
#   1=推 (默认), 0=只推标题+摘要
# AGENT_AUTO_NOTIFY_FULL=1
