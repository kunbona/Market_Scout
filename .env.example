# ── market-radar 基础配置 ──────────────────────────────────
# RSSHub 代理地址（财联社/政策 RSS 依赖）
RSSHUB_BASE_URL=http://rsshub:1200

# 本地量价 Parquet 数据根目录
QUANT_DATA_ROOT=/path/to/Quant_Data

# Flask 服务端口
FLASK_PORT=20026

# 量价计算并发进程数（0=串行，建议 4）
QUANT_WORKERS=4

# Agent 定时分析开关
AGENT_ENABLED=true

# 每日量价计算开关
COMPUTE_ENABLED=true
