# ── market-radar 基础配置 ──────────────────────────────────
# RSSHub 代理地址（财联社/政策 RSS 依赖）
RSSHUB_BASE_URL=http://rsshub:1200

# 本地量价 Parquet 数据根目录
QUANT_DATA_ROOT=/path/to/Quant_Data

# Flask 服务端口
FLASK_PORT=20026

# 量价计算并发进程数（0=串行，建议 4）
QUANT_WORKERS=4

# Agent 定时分析开关
AGENT_ENABLED=true

# 每日量价计算开关
COMPUTE_ENABLED=true

# ── QMT (miniQMT / xtquant) 可选数据源 ────────────────────
# 是否启用 QMT 数据源（需要迅投 miniQMT 客户端在本机运行，并已 pip install xtquant）
# 启用后提供全市逐票涨跌家数和全市成交额；不可用时市场宽度数据跳过采集
QMT_ENABLED=false

# miniQMT 客户端安装根目录（如 D:\Software\东北证券NET专业版）
# 留空时系统仍可连接 miniQMT，但无法在设置页验证路径是否存在
QMT_PATH=

# ── research_board 模块配置 ────────────────────────────────
# OpenRouter API Key（用于 research_board 研报分析，走 OpenRouter 访问 Kimi）
# 申请地址：https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# research_board 独立服务端口（不挂 market-radar 时使用）
RB_PORT=20027
